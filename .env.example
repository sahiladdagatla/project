# FloodTwinAI Environment Configuration (Example)
# No private municipal or paid cloud credentials required.

API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Scientific Default Mode
DEFAULT_OPERATING_MODE=benchmark_simulation

# Experimental Thresholds
CRITICAL_DEPTH_M=0.30
CAUTION_DEPTH_M=0.15
RISK_TOLERANCE_PROBABILITY=0.25
MAX_FORECAST_HORIZON_MINUTES=180
MAX_ALLOWABLE_DETOUR_FACTOR=3.5
